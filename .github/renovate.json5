{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  schedule: [
    'before 8am on the 1st and 15th day of the month',
  ],
  updateNotScheduled: false,
  // Cooldown: don't raise a bump PR until a release has aged, so yanked or
  // compromised releases are caught before they enter the tree. Renovate's
  // equivalent of Dependabot's `cooldown`.
  minimumReleaseAge: '5 days',
  internalChecksFilter: 'strict',
  // Renovate's default go.sum update only records the /go.mod hashes when a
  // bump shifts transitive module versions, so the committed go.sum can miss
  // the full module hashes that `go build` needs and CI fails with "missing
  // go.sum entry". Run `go mod tidy` after each Go update so the committed
  // go.mod and go.sum files stay consistent.
  postUpdateOptions: [
    'gomodTidyAll',
    'gomodUpdateImportPaths',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'WEAVER_IMAGE\\s*\\?=\\s*(?<depName>[^:]+):v(?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchCategories: [
        'ci',
      ],
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'all dependencies',
      groupSlug: 'all-deps',
      matchCategories: [
        '!ci',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
        'digest',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      groupName: 'all major docker dependencies',
      matchCategories: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ], 
    },
    {
      matchManagers: [
        'gomod',
      ],
      separateMultipleMajor: true,
    },
    {
      // This gates all major go updates into individual updates and will disappear
      // when a versioned module is created & old version go mod added to the next rule.
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        '!github.com/stretchr/testify',
        '!go.opentelemetry.io/**',
      ],
      dependencyDashboardApproval: true,
      dependencyDashboardCategory: 'Instrumentation Targets',
      dependencyDashboardHeader: 'The below instrumentation targets are needing a new module directory created.',
    },
    {
      // Each instrumentation module deliberately targets a single major of the
      // library it instruments, so supporting a new major means adding a new
      // module directory (openai-go -> openai-go/v2 -> openai-go/v3), never
      // bumping in place. When a new major gains its own module directory,
      // add the file path for the old go mod added to this rule.
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        '!github.com/stretchr/testify',
        '!go.opentelemetry.io/**',
      ],
      matchFileNames: [
        'instrumentation/github.com/openai/openai-go/go.mod',
        'instrumentation/github.com/openai/openai-go/v2/go.mod',
        'instrumentation/go.mongodb.org/mongo-driver/mongo/go.mod',
      ],
      enabled: false,
    },
  ],
  labels: [
    'dependencies',
  ],
}
