{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  schedule: [
    'before 8am on the 1st and 15th day of the month',
  ],
  updateNotScheduled: false,
  minimumReleaseAge: '5 days',
  internalChecksFilter: 'strict',
  postUpdateOptions: [
    'gomodTidyAll',
    'gomodUpdateImportPaths',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'WEAVER_IMAGE\\s*\\?=\\s*(?<depName>[^:]+):v(?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      dependencyDashboardCategory: 'CI Tooling',
      matchCategories: [
        'ci',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'all ci dependencies',
      groupSlug: 'all-ci deps',
      matchCategories: [
        'ci',
      ],
      matchUpdateTypes: [
        '!major',
      ],
      schedule: '* 0-7 1 * *',
    },
    {
      groupName: 'all dependencies',
      groupSlug: 'all-deps',
      matchCategories: [
        '!ci',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
        'digest',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      groupName: 'all major docker dependencies',
      matchCategories: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      separateMultipleMajor: true,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        '!github.com/stretchr/testify',
        '!go.opentelemetry.io/**',
      ],
      dependencyDashboardApproval: true,
      dependencyDashboardCategory: 'Instrumentation Targets',
      dependencyDashboard: {
        header: 'The below instrumentation targets are needing a new module directory created.',
      },
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        '!github.com/stretchr/testify',
        '!go.opentelemetry.io/**',
      ],
      matchFileNames: [
        'instrumentation/github.com/openai/openai-go/go.mod',
        'instrumentation/github.com/openai/openai-go/v2/go.mod',
        'instrumentation/go.mongodb.org/mongo-driver/mongo/go.mod',
      ],
      enabled: false,
    },
  ],
  labels: [
    'dependencies',
  ],
}
