{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  schedule: [
    'before 8am on the 1st and 15th day of the month',
  ],
  updateNotScheduled: false,
  // Cooldown: don't raise a bump PR until a release has aged, so yanked or
  // compromised releases are caught before they enter the tree. Renovate's
  // equivalent of Dependabot's `cooldown`.
  minimumReleaseAge: '5 days',
  internalChecksFilter: 'strict',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'WEAVER_IMAGE\\s*\\?=\\s*(?<depName>[^:]+):v(?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchFileNames: [
        '.github/**',
      ],
      enabled: false,
    },
    {
      groupName: 'all dependencies',
      groupSlug: 'all-deps',
      matchUpdateTypes: [
        'patch',
        'minor',
        'major',
        'digest',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      // Each instrumentation module deliberately targets a single major of the
      // library it instruments, so supporting a new major means adding a new
      // module directory (openai-go -> openai-go/v2 -> openai-go/v3), never
      // bumping in place. Renovate's Go major update instead adds the new
      // major's module path alongside the old one; `go mod tidy` strips it
      // again because no code imports it, so such a PR can never go green.
      // When a new major gains its own module directory, list its path here.
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        'github.com/openai/openai-go',
        'github.com/openai/openai-go/v2',
        'github.com/openai/openai-go/v3',
        'go.mongodb.org/mongo-driver',
      ],
      enabled: false,
    },
    {
      // k8s.io/client-go v0.36.3 (and the k8s.io/apimachinery, k8s.io/api,
      // and adjacent modules bumped alongside it) requires Go 1.26, which
      // our CI toolchain does not support yet. Ignore updates to this
      // family until the toolchain moves to 1.26+.
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'k8s.io/api',
        'k8s.io/apimachinery',
        'k8s.io/client-go',
        'k8s.io/klog/v2',
        'k8s.io/kube-openapi',
        'k8s.io/utils',
        'sigs.k8s.io/json',
        'sigs.k8s.io/structured-merge-diff/v6',
      ],
      enabled: false,
    },
    {
      // ratchet v0.12.0 raises .tools/go.mod's go directive to 1.25.12,
      // which our CI toolchain (installed from the root go.mod's go 1.25.0)
      // can't build with GOTOOLCHAIN=local. Ignore updates until the
      // toolchain moves to 1.25.12+.
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'github.com/sethvargo/ratchet',
      ],
      enabled: false,
    },
  ],
  labels: [
    'dependencies',
  ],
}
