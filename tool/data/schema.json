            "title": "File Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "assign_value": {
                          "$ref": "#/$defs/InstDeclRuleDo",
                          "description": "InstDeclRule represents a rule that matches a named top-level declaration (function, type, variable, or constant) and applies an action to it."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "assign_value"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "assign_value": {
                        "$ref": "#/$defs/InstDeclRuleDo",
                        "description": "InstDeclRule represents a rule that matches a named top-level declaration (function, type, variable, or constant) and applies an action to it."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "assign_value"
                    ]
