                ]
              },
              "where": {
                "$ref": "#/$defs/InstDeclRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Declaration Rule"
          }
        ]
      }
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "Explicit rule name"
      },
      "target": {
        "type": "string",
        "description": "Target package import path or glob"
      },
      "version": {
        "type": "string",
        "description": "Version range start_inclusive,end_exclusive"
      },
      "imports": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object",
        "description": "Injected imports map (map[alias]path)"
      },
      "where": {
        "anyOf": [
          {
            "$ref": "#/$defs/InstFuncRuleWhere"
          },
          {
            "$ref": "#/$defs/InstRawRuleWhere"
          },
          {
            "$ref": "#/$defs/InstStructRuleWhere"
          },
          {
            "$ref": "#/$defs/InstCallRuleWhere"
          },
          {
            "$ref": "#/$defs/InstDirectiveRuleWhere"
          },
          {
            "$ref": "#/$defs/InstFileRuleWhere"
          },
          {
            "$ref": "#/$defs/InstDeclRuleWhere"
          }
        ],
        "description": "Rule matching conditions. Available fields depend on the rule type."
      },
      "do": {
        "anyOf": [
          {
            "oneOf": [
              {
                "items": {
                  "properties": {
                    "inject_hooks": {
                      "$ref": "#/$defs/InstFuncRuleDo",
                      "description": "InstFuncRule represents a rule that guides hook function injection into appropriate target function locations."
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "inject_hooks"
                  ]
                },
                "type": "array",
                "minItems": 1
              },
