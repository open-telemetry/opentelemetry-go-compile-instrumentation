                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "inject_hooks"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "inject_hooks": {
                        "$ref": "#/$defs/InstFuncRuleDo",
                        "description": "InstFuncRule represents a rule that guides hook function injection into appropriate target function locations."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "inject_hooks"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstFuncRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Function Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "inject_code": {
                          "$ref": "#/$defs/InstRawRuleDo",
                          "description": "InstRawRule represents a rule that allows raw Go source code injection into appropriate target function locations."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "inject_code"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "inject_code": {
                        "$ref": "#/$defs/InstRawRuleDo",
                        "description": "InstRawRule represents a rule that allows raw Go source code injection into appropriate target function locations."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "inject_code"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstRawRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Raw Code Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "add_struct_fields": {
                          "$ref": "#/$defs/InstStructRuleDo",
                          "description": "InstStructRule represents a rule that adds new fields to a target struct."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "add_struct_fields"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "add_struct_fields": {
                        "$ref": "#/$defs/InstStructRuleDo",
                        "description": "InstStructRule represents a rule that adds new fields to a target struct."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "add_struct_fields"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstStructRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Struct Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "wrap_call": {
                          "$ref": "#/$defs/InstCallRuleDo",
                          "description": "InstCallRule represents a rule that wraps function calls at call sites."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "wrap_call"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "wrap_call": {
                        "$ref": "#/$defs/InstCallRuleDo",
                        "description": "InstCallRule represents a rule that wraps function calls at call sites."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "wrap_call"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstCallRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Call Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "expand_directive": {
                          "$ref": "#/$defs/InstDirectiveRuleDo",
                          "description": "InstDirectiveRule represents a rule that instruments functions annotated with magic comments (e.g., //otelc:span) by prepending templated Go code into their bodies."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "expand_directive"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "expand_directive": {
                        "$ref": "#/$defs/InstDirectiveRuleDo",
                        "description": "InstDirectiveRule represents a rule that instruments functions annotated with magic comments (e.g., //otelc:span) by prepending templated Go code into their bodies."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "expand_directive"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstDirectiveRuleWhere"
              }
            },
            "required": [
              "do",
              "where"
            ],
            "title": "Directive Rule"
          },
          {
            "properties": {
              "do": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "add_file": {
                          "$ref": "#/$defs/InstFileRuleDo",
                          "description": "InstFileRule represents a rule that allows adding a new file to the target package."
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "add_file"
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  {
                    "properties": {
                      "add_file": {
                        "$ref": "#/$defs/InstFileRuleDo",
                        "description": "InstFileRule represents a rule that allows adding a new file to the target package."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "add_file"
                    ]
                  }
                ]
              },
              "where": {
                "$ref": "#/$defs/InstFileRuleWhere"
              }
            },
            "required": [
              "do"
