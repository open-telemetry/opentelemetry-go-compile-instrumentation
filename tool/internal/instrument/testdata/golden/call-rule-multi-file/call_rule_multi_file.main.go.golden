import "unsafe"

func Wrapper(size uintptr) uintptr {
	println("Wrapped!")
	return size
}

func CallSizeof() {
	x := 42
	size := Wrapper(unsafe.Sizeof(x))
	/*line /golden/work/main.go:16*/ _ = size
}

func main() {
	y := "hello"
	_ = Wrapper(unsafe.Sizeof(y)) /*line /golden/work/main.go:21*/
}
