package main

import "unsafe"

func Wrapper(size uintptr) uintptr {
	println("Wrapped!")
	return size
}

func main() {
	x := 42
	//otelc:ignore
	ignored := unsafe.Sizeof(x)
	_ = ignored

	y := "hello"
	kept := Wrapper(unsafe.Sizeof(y))
	_ = kept
}
